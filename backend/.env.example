# Comma-separated list of frontend origins allowed to call this API.
# Leaving this unset falls back to a built-in default list that already
# covers local development (http://localhost, http://127.0.0.1:5500, etc.)
# AND the production Firebase Hosting URLs below — so the API works out of
# the box either way. Only set this if you need a different/extra origin
# (e.g. a custom domain).
ALLOWED_ORIGINS=https://agrivision-84da7.web.app,https://agrivision-84da7.firebaseapp.com

# Render sets PORT automatically — no action needed, the Dockerfile already reads it.
